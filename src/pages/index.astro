---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import { profile, capabilities, studies, experience, principles, toolkit } from '../data.js';
import StudyCard from '../components/StudyCard.astro';

const repositoryStudies = studies.filter((study) => study.repoUrl);
const conceptStudies = studies.filter((study) => !study.repoUrl);

const heroPortrait = {
  base: '/assets/hero-portrait.webp',
  cutout: '/assets/hero-portrait.webp',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e7e6e3" />
    <meta name="description" content="Sanjay S. · Cybersecurity research, security engineering, and evidence-led practice." />
    <title>{profile.name} · Cybersecurity Researcher</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="reading-line" aria-hidden="true"></div>
    <div class="cursor-tracker" data-cursor-tracker aria-hidden="true"></div>
    <header class="site-header" data-header>
      <a class="wordmark" href="#top" aria-label="Sanjay S., home">© SANJAY S.</a>
      <nav class="main-nav" id="main-nav" aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#practice">Practice</a>
        <a href="#about">About</a>
        <a href="#toolkit">Toolkit</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="header-tools">
        <a class="availability" href="#contact"><span aria-hidden="true"></span>Open to opportunities</a>
        <button class="motion-toggle" type="button" aria-pressed="false" aria-label="Pause motion" data-motion-toggle>Pause motion</button>
      </div>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>Menu</button>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <p class="hero-kicker">Cybersecurity research <span>·</span> Security engineering</p>
        <div class="hero-roles" aria-label={`Primary focus: ${profile.roles[0]}. Supporting practice: ${profile.roles[1]}.`}>
          <span class="hero-role-primary"><span class="hero-role-label">Primary focus</span>{profile.roles[0]}</span>
          <em><span class="hero-role-label">Supporting practice</span>{profile.roles[1]}</em>
        </div>
        {heroPortrait && <div class="hero-portrait" aria-hidden="true">
          <img class="hero-portrait-base" src={heroPortrait.base} alt="" fetchpriority="high" />
          <img class="hero-portrait-cutout" src={heroPortrait.cutout} alt="" fetchpriority="high" />
        </div>}
        <h1 class="hero-title" id="hero-title" aria-label={profile.name}>
          <span class="hero-track" aria-hidden="true">
            <span class="hero-word">Sanjay <em>S.</em></span>
            <span class="hero-word">Sanjay <em>S.</em></span>
          </span>
        </h1>
        <div class="hero-social" aria-label="Professional profiles">
          {profile.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
        </div>
        <a class="hero-cta" href="#work"><span>Selected work</span><span class="cta-rule" aria-hidden="true"></span><span class="cta-index">01</span></a>
        <span class="hero-location">{profile.location} <span>·</span> 09.59° N</span>
        <span class="hero-side-note" aria-hidden="true">Research with intent / 2026</span>
      </section>

      <section class="intro dark-section" id="intro" aria-labelledby="intro-title">
        <div class="section-wrap intro-layout">
          <div class="intro-label section-index reveal"><span>01</span> / Intro</div>
          <div class="intro-copy">
            <h2 class="intro-title split-reveal" id="intro-title">
              <span>Understanding threats.</span>
              <span>Engineering <em>defence.</em></span>
              <span>Building what comes next.</span>
            </h2>
            <div class="intro-bottom reveal">
              <p>{profile.intro}</p>
              <a class="text-link" href="#practice">Explore my practice <span aria-hidden="true">↘</span></a>
            </div>
          </div>
          <figure class="intro-object" data-depth>
            <img src="/assets/security-helmet-cutout.webp" alt="A sculptural 3D cyber-security helmet with fine orbiting components." width="1200" height="800" fetchpriority="high" />
            <figcaption>01 / A study in protection and exposure</figcaption>
          </figure>
        </div>
      </section>

      <section class="practice light-section" id="practice" aria-labelledby="practice-title">
        <div class="section-wrap">
          <div class="practice-heading reveal">
            <span class="section-index"><span>02</span> / Practice</span>
            <h2 id="practice-title" tabindex="-1">A practice built<br /><em>around evidence.</em></h2>
            <p>Four connected fields. One steady question: what can we prove, and what can we improve?</p>
          </div>
          <div class="capability-layout">
            <div class="capability-list">
              {capabilities.map((item) => <article class="capability-row reveal">
                <span class="capability-number">{item.number}</span>
                <div class="capability-main">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
                <details class="capability-details" open={item.number === '01'}>
                  <summary aria-label={`Focus areas for ${item.title}`}>
                    <span>Focus areas</span>
                    <span class="capability-mark" aria-hidden="true">+</span>
                  </summary>
                  <ul>{item.focus.map((focus) => <li>{focus}</li>)}</ul>
                </details>
              </article>)}
            </div>
          </div>
        </div>
      </section>

      <section class="work dark-section" id="work" aria-labelledby="work-title">
        <div class="section-wrap">
          <div class="section-heading work-heading reveal">
            <span class="section-index"><span>03</span> / Selected work</span>
            <div>
              <h2 id="work-title" tabindex="-1">Nine projects.<br /><em>One point of view.</em></h2>
              <p>Concepts, prototypes, and ongoing practice. Each study is labeled for its current stage.</p>
              <p class="work-art-note">The project visuals are illustrative 3D artwork; repository links lead to source code.</p>
              <a class="text-link work-source-link" href="https://github.com/samurai-io?tab=repositories" target="_blank" rel="noopener noreferrer">Browse all repositories <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="study-groups">
            <section class="study-group" aria-labelledby="repository-studies-title">
              <div class="study-group-heading">
                <h3 id="repository-studies-title"><span>01</span> / Public repositories</h3>
                <p>{repositoryStudies.length} studies with source links</p>
              </div>
              <div class="study-carousel" role="region" aria-roledescription="carousel" aria-label="Public repository projects" data-study-carousel data-carousel-label="Repository study">
                <div class="study-list">
                  {repositoryStudies.map((study) => <StudyCard study={study} />)}
                </div>
                <div class="study-carousel-controls" role="group" aria-label="Public repository carousel controls">
                  <button type="button" data-carousel-prev aria-label="Previous repository study">← Previous</button>
                  <span class="study-carousel-counter" aria-hidden="true">01 / {String(repositoryStudies.length).padStart(2, '0')}</span>
                  <button type="button" data-carousel-next aria-label="Next repository study">Next →</button>
                  <button type="button" class="study-carousel-toggle" data-carousel-toggle>Pause rotation</button>
                </div>
                <p class="study-carousel-live" data-carousel-live aria-live="polite" aria-atomic="true"></p>
              </div>
            </section>
            <section class="study-group" aria-labelledby="practice-studies-title">
              <div class="study-group-heading">
                <h3 id="practice-studies-title"><span>02</span> / Concepts &amp; practice</h3>
                <p>Research directions, a hackathon concept, and ongoing lab work</p>
              </div>
              <div class="study-carousel" role="region" aria-roledescription="carousel" aria-label="Concepts and practice projects" data-study-carousel data-carousel-label="Concept and practice study">
                <div class="study-list">
                  {conceptStudies.map((study) => <StudyCard study={study} />)}
                </div>
                <div class="study-carousel-controls" role="group" aria-label="Concepts and practice carousel controls">
                  <button type="button" data-carousel-prev aria-label="Previous concept or practice study">← Previous</button>
                  <span class="study-carousel-counter" aria-hidden="true">01 / {String(conceptStudies.length).padStart(2, '0')}</span>
                  <button type="button" data-carousel-next aria-label="Next concept or practice study">Next →</button>
                  <button type="button" class="study-carousel-toggle" data-carousel-toggle>Pause rotation</button>
                </div>
                <p class="study-carousel-live" data-carousel-live aria-live="polite" aria-atomic="true"></p>
              </div>
            </section>
          </div>
        </div>
      </section>

      <section class="about dark-section" id="about" aria-labelledby="about-title">
        <div class="section-wrap about-layout">
          <div class="section-index reveal"><span>04</span> / About</div>
          <div class="about-main reveal">
            <h2 id="about-title" tabindex="-1">Curiosity finds the weak point.<br /><em>Research makes it useful.</em></h2>
            <div class="about-columns">
              <p>{profile.about}</p>
              <div class="about-facts">
                <p class="fact-label">Education</p>
                <p>{profile.education}<br />{profile.institution}</p>
                <p class="fact-label">Experience</p>
                {experience.map((item) => <p class="experience-row"><span>{item.date}</span><span>{item.role}<br /><strong>{item.organization}</strong></span></p>)}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="toolkit light-section" id="toolkit" aria-labelledby="toolkit-title">
        <div class="section-wrap">
          <div class="section-heading reveal">
            <span class="section-index"><span>05</span> / Toolkit</span>
            <div><h2 id="toolkit-title" tabindex="-1">Tools for<br /><em>the work.</em></h2></div>
          </div>
          <div class="toolkit-list">
            {toolkit.map((group, index) => <div class="toolkit-row reveal">
              <span class="toolkit-number">0{index + 1}</span>
              <h3>{group.label}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </div>)}
          </div>
        </div>
      </section>

      <section class="principles dark-section" id="approach" aria-labelledby="principles-title">
        <div class="section-wrap">
          <div class="principles-head reveal">
            <span class="section-index"><span>06</span> / Approach</span>
            <h2 id="principles-title" tabindex="-1">How I work<br /><em>through a problem.</em></h2>
          </div>
          <ol class="principle-list">
            {principles.map((principle) => <li class="principle reveal">
              <span class="principle-number">{principle.number}</span>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </li>)}
          </ol>
        </div>
      </section>

      <footer class="contact" id="contact" aria-labelledby="contact-title">
        <div class="section-wrap contact-wrap">
          <span class="section-index reveal"><span>07</span> / Contact</span>
          <h2 class="contact-title reveal" id="contact-title" tabindex="-1" aria-label="Reach out, Sanjay S.">
            <span class="contact-title-main" aria-hidden="true">Reach <em>out.</em></span>
            <span class="contact-track" aria-hidden="true">
              <span>Cybersecurity research · Sanjay S.</span>
              <span>Cybersecurity research · Sanjay S.</span>
            </span>
          </h2>
          <div class="contact-details reveal">
            <span class="contact-eyebrow">Start a conversation</span>
            <p>Open to cybersecurity research, defensive engineering, technical collaborations, and thoughtful projects.</p>
            <a class="contact-email" href={'mailto:' + profile.email}>{profile.email}</a>
            <div class="contact-social">
              {profile.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
            </div>
          </div>
          <div class="contact-foot"><span class="contact-copyright">© {new Date().getFullYear()} {profile.name} · Independent practice</span><span class="contact-location">{profile.location}</span><a href="#top">Back to top ↑</a></div>
        </div>
      </footer>
    </main>
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>
